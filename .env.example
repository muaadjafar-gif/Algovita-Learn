# Copy to .env.local and fill in real values

# MongoDB (Atlas connection string or local mongod)
MONGODB_URI=mongodb://127.0.0.1:27017/algovita-lms

# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-string

# Razorpay (Dashboard > Account & Settings > API Keys). Use rzp_test_ keys while developing.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard > Webhooks > secret you choose (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=choose-a-webhook-secret

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used by `npm run seed` to create the first admin account
ADMIN_NAME=Algovita Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@12345
